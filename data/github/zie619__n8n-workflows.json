    "html": "<pre><code class=\"language-bash\"># Clone the repository\ngit clone https://github.com/Zie619/n8n-workflows.git\ncd n8n-workflows\n\n# Install dependencies\npip install -r requirements.txt\n\n# Start the server\npython run.py\n\n# Open in browser\n# http://localhost:8000\n</code></pre>",
