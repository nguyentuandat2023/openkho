# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG đưa .env.local lên Git.

# Token GitHub (khuyến nghị): tăng hạn mức từ 60 lên 5.000 lượt/giờ và bật chế độ đồng bộ đầy đủ
# (GraphQL: danh sách file tải về của bản phát hành, tốc độ tăng sao thực tế…).
# Tạo tại https://github.com/settings/personal-access-tokens → Fine-grained token
#   - Repository access: "Public repositories (read-only)"
#   - Không cần thêm quyền nào khác.
# Hoặc nếu đã cài GitHub CLI: chạy `gh auth token` rồi dán vào đây.
GITHUB_TOKEN=

# Đường dẫn con khi đặt website trong thư mục (vd. GitHub Pages dạng /ten-repo). Để trống nếu dùng tên miền riêng.
BASE_PATH=

# Cổng cho trang quản trị cục bộ (npm run admin)
ADMIN_PORT=4321

# --- Trang quản trị (npm run admin) ---
# Mật khẩu đăng nhập trang quản trị. Bắt buộc nếu mở trang ra mạng bằng ADMIN_HOST.
ADMIN_PASSWORD=
# Mặc định 127.0.0.1 (chỉ máy này). Đặt 0.0.0.0 để mở ra mạng nội bộ — cần ADMIN_PASSWORD và ADMIN_ORIGIN.
ADMIN_HOST=
# Địa chỉ trang khi mở ra mạng, vd. http://192.168.1.10:4321 (dùng để chống CSRF)
ADMIN_ORIGIN=
# Khóa ký phiên đăng nhập (tùy chọn). Để trống: tạo ngẫu nhiên mỗi lần khởi động (phải đăng nhập lại).
ADMIN_SESSION_SECRET=

# --- Phân tích README bằng AI (TÙY CHỌN, mặc định tắt; tốn phí theo token) ---
# Chỉ dùng khi bật ai.enabled trong data/settings.json. Xem docs/04-HE-THONG-TU-DONG.md mục 8.
ANTHROPIC_API_KEY=
